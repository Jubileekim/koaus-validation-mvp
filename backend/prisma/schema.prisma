generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  ARTICLE
  REEL
}

model Editor {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  avatarUrl String?
  posts     Post[]
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      PostType @default(ARTICLE)
  imageUrl  String?
  videoUrl  String?
  editorId  String
  editor    Editor   @relation(fields: [editorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  price       Float?
  imageUrl    String?
  externalUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
